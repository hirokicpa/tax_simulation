<div class="page-simulation-first_second_succession-index">
  <div class="top-image-size"></div>

  <div class="container-fluid">
    <div class="row justify-content-center mt-4 mb-2 px-3">
      <div class="col-12 col-md-8 col-lg-6 px-0">
        <div class="content-title mt-4 mb-3 text-center font-weight-bold">
          1次相続による2次相続への<br>影響のシミュレーション
        </div>

        <div class="text-right mb-3 pr-2 small text-muted">
          ※ 値はすべて <span class="font-weight-bold">半角英数</span> で入力してください
        </div>

        <%= form_tag(simulations_first_second_succession_result_tax_path, method: :get, remote: true) do %>
          <table class="table table-bordered">
            <tbody>
              <!-- 現在の遺産総額 -->
              <tr>
                <th class="align-middle text-center" style="width: 40%;">現在の遺産総額</th>
                <td>
                  <div class="input-group">
                    <%= text_field_tag :total_heritage, "", class: "form-control text-right", pattern: "^[0-9]+$", required: true %>
                    <div class="input-group-append">
                      <span class="input-group-text">万円</span>
                    </div>
                  </div>
                </td>
              </tr>

              <!-- 子供の人数 -->
              <tr>
                <th class="align-middle text-center">子供の人数</th>
                <td>
                  <%= select_tag "count_heir_children", options_for_select([
                    ["選択してください", "0"],
                    ["1人", "1"],
                    ["2人", "2"],
                    ["3人", "3"],
                    ["4人", "4"],
                    ["5人", "5"]
                  ]), class: "form-control", required: true %>
                </td>
              </tr>

              <!-- 配偶者の固有の財産 -->
              <tr>
                <th class="align-middle text-center">配偶者の固有の財産</th>
                <td>
                  <div class="input-group">
                    <%= text_field_tag :mate_own_heritage, "", class: "form-control text-right", pattern: "^[0-9]+$", required: true %>
                    <div class="input-group-append">
                      <span class="input-group-text">万円</span>
                    </div>
                  </div>
                </td>
              </tr>
            </tbody>
          </table>

          <div class="text-center mt-4 mb-5">
            <%= submit_tag "計算する", class: "btn btn-primary btn-lg px-5 py-2", id: "btn_first_second_succession" %>
          </div>
        <% end %>
      </div>
    </div>

    <!-- 結果表示 -->
    <div class="row justify-content-center">
      <div class="col-12 col-md-10 mt-5 mb-5">
        <div id="result_first_second_succession" class="bg-light p-4 rounded shadow-sm"></div>
      </div>
    </div>
  </div>
</div>

