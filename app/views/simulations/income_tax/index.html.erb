<div class="row business-succession-container">
  <div class="card mx-auto col-12 col-md-10 col-lg-9 modern-card">
    <div class="card-body px-4 py-4">
      <div class="header-section text-center mb-4">
        <div class="icon-wrapper mb-3">
          <i class="fa fa-calculator fa-3x text-primary" aria-hidden="true"></i>
        </div>
        <h4 class="card-title mb-2 font-weight-bold">
          所得税の<br>シミュレーション
        </h4>
        <p class="text-muted small mb-0">所得税額を計算します</p>
      </div>

      <div class="alert alert-info alert-modern mb-4">
        <div class="d-flex align-items-start">
          <i class="fa fa-info-circle fa-lg mr-2 mt-1"></i>
          <div>
            <strong class="d-block mb-2">入力時のご注意</strong>
            <ul class="mb-0 pl-3">
              <li>値はすべて<strong>半角数字</strong>で入力してください。</li>
              <li>基礎控除は所得金額に応じて自動設定されます（令和8年分基準）。</li>
              <li>あくまでも目安としてご利用ください。</li>
            </ul>
          </div>
        </div>
      </div>

      <%= form_tag(simulations_income_tax_result_tax_path, method: :get, remote: true, html: { accept_charset: "UTF-8", class: "modern-form", id: "income_tax_form" }) do %>
        <div class="form-sections">
          <div class="form-section">
            <div class="form-group">
              <label class="form-label">
                <span class="step-number">①</span>
                <span class="label-text">所得</span>
              </label>
              <div class="input-group-modern">
                <%= text_field_tag :income, params[:income], 
                    class: "form-control form-control-modern text-right",
                    id: "income_input",
                    inputmode: "numeric",
                    pattern: "^[0-9]+$",
                    required: "",
                    placeholder: "0" %>
                <span class="input-unit">万円</span>
              </div>
              <div class="form-help-text">
                <i class="fa fa-info-circle mr-1"></i>
                合計所得金額を入力してください
              </div>
            </div>
          </div>

          <div class="form-section">
            <div class="form-group">
              <label class="form-label">
                <span class="step-number">②</span>
                <span class="label-text">所得控除合計</span>
              </label>
              <div class="input-group-modern">
                <%= text_field_tag :total_income_deduction, params[:total_income_deduction] || "104",
                    class: "form-control form-control-modern text-right",
                    id: "total_income_deduction",
                    inputmode: "numeric",
                    pattern: "^[0-9]+$",
                    required: "",
                    placeholder: "104" %>
                <span class="input-unit">万円</span>
              </div>
              <div class="form-help-text">
                <i class="fa fa-info-circle mr-1"></i>
                基礎控除: <span id="basic_deduction_display">104</span>万円（自動設定）
              </div>
              
              <div class="mt-3">
                <div class="card caution-card">
                  <div class="card-body">
                    <h6 class="card-title">
                      <i class="fa fa-list mr-2"></i>基礎控除以外の所得控除金額
                    </h6>
                    <div class="collapse" id="deductionBreakdown">
                      <div class="card-body pt-2">
                        <div class="row">
                          <div class="col-md-6 mb-2">
                            <div class="input-group input-group-sm">
                              <%= text_field_tag :breakdown1, params[:breakdown1], 
                                  class: "form-control text-right",
                                  id: "breakdown1",
                                  inputmode: "numeric",
                                  pattern: "^[0-9]+$",
                                  placeholder: "0" %>
                              <div class="input-group-append">
                                <span class="input-group-text">万円</span>
                              </div>
                              <label class="form-label small ml-2">雑損控除</label>
                            </div>
                          </div>
                          <div class="col-md-6 mb-2">
                            <div class="input-group input-group-sm">
                              <%= text_field_tag :breakdown2, params[:breakdown2],
                                  class: "form-control text-right",
                                  id: "breakdown2",
                                  inputmode: "numeric",
                                  pattern: "^[0-9]+$",
                                  placeholder: "0" %>
                              <div class="input-group-append">
                                <span class="input-group-text">万円</span>
                              </div>
                              <label class="form-label small ml-2">医療費控除</label>
                            </div>
                          </div>
                          <div class="col-md-6 mb-2">
                            <div class="input-group input-group-sm">
                              <%= text_field_tag :breakdown3, params[:breakdown3],
                                  class: "form-control text-right",
                                  id: "breakdown3",
                                  inputmode: "numeric",
                                  pattern: "^[0-9]+$",
                                  placeholder: "0" %>
                              <div class="input-group-append">
                                <span class="input-group-text">万円</span>
                              </div>
                              <label class="form-label small ml-2">社会保険料控除</label>
                            </div>
                          </div>
                          <div class="col-md-6 mb-2">
                            <div class="input-group input-group-sm">
                              <%= text_field_tag :breakdown4, params[:breakdown4],
                                  class: "form-control text-right",
                                  id: "breakdown4",
                                  inputmode: "numeric",
                                  pattern: "^[0-9]+$",
                                  placeholder: "0" %>
                              <div class="input-group-append">
                                <span class="input-group-text">万円</span>
                              </div>
                              <label class="form-label small ml-2">小規模企業共済等掛金控除</label>
                            </div>
                          </div>
                          <div class="col-md-6 mb-2">
                            <div class="input-group input-group-sm">
                              <%= text_field_tag :breakdown5, params[:breakdown5],
                                  class: "form-control text-right",
                                  id: "breakdown5",
                                  inputmode: "numeric",
                                  pattern: "^[0-9]+$",
                                  placeholder: "0" %>
                              <div class="input-group-append">
                                <span class="input-group-text">万円</span>
                              </div>
                              <label class="form-label small ml-2">生命保険料控除</label>
                            </div>
                          </div>
                          <div class="col-md-6 mb-2">
                            <div class="input-group input-group-sm">
                              <%= text_field_tag :breakdown6, params[:breakdown6],
                                  class: "form-control text-right",
                                  id: "breakdown6",
                                  inputmode: "numeric",
                                  pattern: "^[0-9]+$",
                                  placeholder: "0" %>
                              <div class="input-group-append">
                                <span class="input-group-text">万円</span>
                              </div>
                              <label class="form-label small ml-2">地震保険料控除</label>
                            </div>
                          </div>
                          <div class="col-md-6 mb-2">
                            <div class="input-group input-group-sm">
                              <%= text_field_tag :breakdown7, params[:breakdown7],
                                  class: "form-control text-right",
                                  id: "breakdown7",
                                  inputmode: "numeric",
                                  pattern: "^[0-9]+$",
                                  placeholder: "0" %>
                              <div class="input-group-append">
                                <span class="input-group-text">万円</span>
                              </div>
                              <label class="form-label small ml-2">寄附金控除</label>
                            </div>
                          </div>
                          <div class="col-md-6 mb-2">
                            <div class="input-group input-group-sm">
                              <%= text_field_tag :breakdown8, params[:breakdown8],
                                  class: "form-control text-right",
                                  id: "breakdown8",
                                  inputmode: "numeric",
                                  pattern: "^[0-9]+$",
                                  placeholder: "0" %>
                              <div class="input-group-append">
                                <span class="input-group-text">万円</span>
                              </div>
                              <label class="form-label small ml-2">寡婦、寡夫控除</label>
                            </div>
                          </div>
                          <div class="col-md-6 mb-2">
                            <div class="input-group input-group-sm">
                              <%= text_field_tag :breakdown9, params[:breakdown9],
                                  class: "form-control text-right",
                                  id: "breakdown9",
                                  inputmode: "numeric",
                                  pattern: "^[0-9]+$",
                                  placeholder: "0" %>
                              <div class="input-group-append">
                                <span class="input-group-text">万円</span>
                              </div>
                              <label class="form-label small ml-2">勤労学生、障害者</label>
                            </div>
                          </div>
                          <div class="col-md-6 mb-2">
                            <div class="input-group input-group-sm">
                              <%= text_field_tag :breakdown10, params[:breakdown10],
                                  class: "form-control text-right",
                                  id: "breakdown10",
                                  inputmode: "numeric",
                                  pattern: "^[0-9]+$",
                                  placeholder: "0" %>
                              <div class="input-group-append">
                                <span class="input-group-text">万円</span>
                              </div>
                              <label class="form-label small ml-2">配偶者控除</label>
                            </div>
                          </div>
                          <div class="col-md-6 mb-2">
                            <div class="input-group input-group-sm">
                              <%= text_field_tag :breakdown11, params[:breakdown11],
                                  class: "form-control text-right",
                                  id: "breakdown11",
                                  inputmode: "numeric",
                                  pattern: "^[0-9]+$",
                                  placeholder: "0" %>
                              <div class="input-group-append">
                                <span class="input-group-text">万円</span>
                              </div>
                              <label class="form-label small ml-2">配偶者特別控除</label>
                            </div>
                          </div>
                          <div class="col-md-6 mb-2">
                            <div class="input-group input-group-sm">
                              <%= text_field_tag :breakdown12, params[:breakdown12],
                                  class: "form-control text-right",
                                  id: "breakdown12",
                                  inputmode: "numeric",
                                  pattern: "^[0-9]+$",
                                  placeholder: "0" %>
                              <div class="input-group-append">
                                <span class="input-group-text">万円</span>
                              </div>
                              <label class="form-label small ml-2">扶養控除</label>
                            </div>
                          </div>
                        </div>
                        <div class="text-center mt-3">
                          <button type="button" class="btn btn-outline-secondary btn-sm" id="reset_btn">
                            <i class="fa fa-refresh mr-1"></i>リセット
                          </button>
                        </div>
                      </div>
                    </div>
                    <div class="text-center">
                      <button class="btn btn-link" type="button" data-bs-toggle="collapse" data-bs-target="#deductionBreakdown" aria-expanded="false" aria-controls="deductionBreakdown">
                        <i class="fa fa-chevron-down mr-1"></i>内訳を入力する
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="text-center mt-4">
          <%= submit_tag "計算する", class: "btn btn-primary btn-lg btn-calculate", id: "btn_income_tax" %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- 結果表示 -->
  <div class="mx-auto my-4 col-12 col-md-10 col-lg-9 px-0" id="result-section">
    <div id="result_income_tax" class="card result-card" style="display: none;">
      <div class="card-body p-4">
        <div id="result-content"></div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const incomeInput = document.getElementById('income_input');
    const totalIncomeDeductionField = document.getElementById('total_income_deduction');
    const basicDeductionDisplay = document.getElementById('basic_deduction_display');
    
    // 基礎控除の自動計算（令和8年分基準）
    function calculateBasicDeduction(income) {
      const incomeValue = parseInt(income, 10) || 0;
      
      if (incomeValue <= 489) {
        return 104; // 489万円以下: 104万円
      } else if (incomeValue <= 655) {
        return 67; // 489万円超 655万円以下: 67万円
      } else if (incomeValue <= 2350) {
        return 62; // 655万円超2,350万円以下: 62万円
      } else if (incomeValue <= 2400) {
        return 48; // 2,350万円超2,400万円以下: 48万円
      } else if (incomeValue <= 2450) {
        return 32; // 2,400万円超2,450万円以下: 32万円
      } else if (incomeValue <= 2500) {
        return 16; // 2,450万円超2,500万円以下: 16万円
      } else {
        return 0; // 2,500万円超: 0円
      }
    }
    
    // 手動入力モードのフラグ
    let isManualInputMode = false;
    
    // 内訳入力欄の合計を計算して所得控除合計欄に反映する関数
    function updateTotalIncomeDeduction() {
      // 手動入力モードの場合は自動更新をスキップ
      if (isManualInputMode) {
        return;
      }
      
      let total = 0;
      
      // breakdown1〜breakdown12の合計を計算
      for (let i = 1; i <= 12; i++) {
        const field = document.getElementById('breakdown' + i);
        if (field && field.value) {
          const value = parseFloat(field.value.replace(/,/g, '')) || 0;
          total += value;
        }
      }
      
      // 基礎控除を取得
      const income = incomeInput ? (incomeInput.value.replace(/,/g, '') || '0') : '0';
      const basicDeduction = calculateBasicDeduction(income);
      
      // 基礎控除を表示
      if (basicDeductionDisplay) {
        basicDeductionDisplay.textContent = basicDeduction;
      }
      
      // 基礎控除が0の場合でも、内訳の合計は反映する
      const finalTotal = basicDeduction + total;
      
      // 所得控除合計欄に反映
      if (totalIncomeDeductionField) {
        totalIncomeDeductionField.value = finalTotal;
      }
    }
    
    // 所得入力時に基礎控除を自動更新
    if (incomeInput) {
      incomeInput.addEventListener('input', function() {
        // 基礎控除が0になる場合は手動入力モードを解除して自動更新を許可
        const income = incomeInput.value.replace(/,/g, '') || '0';
        const basicDeduction = calculateBasicDeduction(income);
        if (basicDeduction === 0) {
          isManualInputMode = false; // 基礎控除が0の場合は自動更新を許可
        }
        updateTotalIncomeDeduction();
      });
      
      // 初期値の設定
      const initialIncome = incomeInput.value.replace(/,/g, '');
      if (initialIncome) {
        const basicDeduction = calculateBasicDeduction(initialIncome);
        if (basicDeduction === 0) {
          isManualInputMode = false; // 基礎控除が0の場合は自動更新を許可
        }
        updateTotalIncomeDeduction();
      }
    }
    
    // 所得控除合計欄の手動入力時の処理
    if (totalIncomeDeductionField) {
      // フォーカス時：手動入力モードを有効化
      totalIncomeDeductionField.addEventListener('focus', function() {
        const income = incomeInput ? (incomeInput.value.replace(/,/g, '') || '0') : '0';
        const basicDeduction = calculateBasicDeduction(income);
        // 基礎控除が0の場合は手動入力モードを有効化
        if (basicDeduction === 0) {
          isManualInputMode = true;
        }
      });
      
      // 手動入力時：手動入力モードを維持
      totalIncomeDeductionField.addEventListener('input', function() {
        const income = incomeInput ? (incomeInput.value.replace(/,/g, '') || '0') : '0';
        const basicDeduction = calculateBasicDeduction(income);
        // 基礎控除が0の場合は手動入力モードを維持
        if (basicDeduction === 0) {
          isManualInputMode = true;
        }
      });
      
      // フォーカスが外れた時：基礎控除が0でない場合は自動更新を再開
      totalIncomeDeductionField.addEventListener('blur', function() {
        const income = incomeInput ? (incomeInput.value.replace(/,/g, '') || '0') : '0';
        const basicDeduction = calculateBasicDeduction(income);
        // 基礎控除が0でない場合は手動入力モードを解除
        if (basicDeduction !== 0) {
          isManualInputMode = false;
          updateTotalIncomeDeduction();
        }
      });
    }
    
    // breakdown1〜breakdown12の各入力欄にイベントリスナーを追加
    for (let i = 1; i <= 12; i++) {
      const field = document.getElementById('breakdown' + i);
      if (field) {
        // inputイベント（リアルタイム更新）
        field.addEventListener('input', updateTotalIncomeDeduction);
        // blurイベント（フォーカスが外れたとき）
        field.addEventListener('blur', updateTotalIncomeDeduction);
      }
    }
    
    // リセットボタンの処理
    const resetBtn = document.getElementById('reset_btn');
    if (resetBtn) {
      resetBtn.addEventListener('click', function() {
        for (let i = 1; i <= 12; i++) {
          const field = document.getElementById('breakdown' + i);
          if (field) {
            field.value = '';
          }
        }
        // リセット後、基礎控除のみを反映
        updateTotalIncomeDeduction();
      });
    }
    
    // Bootstrap 5のCollapseを初期化（jQueryが利用できない場合のフォールバック）
    const collapseElement = document.getElementById('deductionBreakdown');
    const collapseButton = document.querySelector('[data-bs-target="#deductionBreakdown"]');
    
    if (collapseButton && typeof bootstrap !== 'undefined') {
      collapseButton.addEventListener('click', function(e) {
        e.preventDefault();
        const bsCollapse = new bootstrap.Collapse(collapseElement, {
          toggle: true
        });
      });
    } else if (collapseButton && typeof $ !== 'undefined') {
      // jQueryが利用可能な場合
      collapseButton.addEventListener('click', function(e) {
        e.preventDefault();
        $('#deductionBreakdown').collapse('toggle');
      });
    }
    
    // ページ読み込み時に初期値を設定
    updateTotalIncomeDeduction();
  });
</script>

