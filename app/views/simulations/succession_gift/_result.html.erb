<div class="result-content">
  <div class="table-responsive mb-4">
    <table class="table table-bordered table-modern">
      <thead>
        <tr>
          <th class="text-center" style="width: 15%;"></th>
          <th class="text-center" style="width: 25%;">贈与実行前</th>
          <th class="text-center" style="width: 25%;">贈与実行後</th>
          <th class="text-center" style="width: 25%;">差額</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th class="text-center">贈与税</th>
          <td class="text-right">0 万円</td>
          <td class="text-right"><%= @result_gift.to_s(:delimited) %> 万円</td>
          <td class="text-right"><%= (@result_gift - 0).to_s(:delimited) %> 万円</td>
        </tr>
        <tr>
          <th class="text-center">相続税</th>
          <td class="text-right"><%= @result_before_gift.to_s(:delimited) %> 万円</td>
          <td class="text-right"><%= @result_after_gift.to_s(:delimited) %> 万円</td>
          <td class="text-right"><%= (@result_after_gift - @result_before_gift).to_s(:delimited) %> 万円</td>
        </tr>
        <tr class="table-active">
          <th class="text-center font-weight-bold">合計</th>
          <td class="text-right font-weight-bold"><%= (0 + @result_before_gift).to_s(:delimited) %> 万円</td>
          <td class="text-right font-weight-bold"><%= (@result_gift + @result_after_gift).to_s(:delimited) %> 万円</td>
          <% total_result = ((@result_gift + @result_after_gift) - (0 + @result_before_gift)) %>
          <td class="text-right font-weight-bold <%= total_result <= 0 ? 'text-success' : 'text-danger' %>">
            <%= total_result.to_s(:delimited) %> 万円
          </td>
        </tr>
      </tbody>
    </table>
  </div>
  
  <div class="alert alert-info alert-modern mb-4">
    <div class="d-flex align-items-start">
      <i class="fa fa-info-circle fa-lg mr-2 mt-1"></i>
      <div>
        <small class="text-muted">*相続税は配偶者控除適用前の一次相続税の総額を表示しています。</small>
      </div>
    </div>
  </div>
  
  <div class="result-summary text-center p-4 bg-light rounded">
    <h6 class="font-weight-bold mb-3">
      <i class="fa fa-<%= total_result <= 0 ? 'check-circle' : 'exclamation-circle' %> mr-2 <%= total_result <= 0 ? 'text-success' : 'text-warning' %>"></i>
      結果
    </h6>
    <div class="result-summary-items">
      <div class="result-summary-item">
        <p class="mb-0" style="font-size: 1.1rem;">
          <% if total_result <= 0 %>
            <span class="text-success font-weight-bold">
              上記贈与を実行した場合、相続税と贈与税の合計額が <%= (-total_result).to_s(:delimited) %> 万円減少します。
            </span>
          <% elsif total_result > 0 %>
            <span class="text-danger font-weight-bold">
              上記贈与を実行した場合、相続税と贈与税の合計額が <%= total_result.to_s(:delimited) %> 万円増加します。
            </span>
          <% end %>
        </p>
      </div>
    </div>
  </div>
</div>
