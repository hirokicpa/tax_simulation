<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-md-10">
      <h2 class="text-center mt-5 mb-4"><%= @board.title %>に関する質問投稿</h2>

      <div class="text-center mb-5">
        <%= link_to "新しい質問を投稿する", new_board_question_path(@board), class: "btn btn-primary btn-lg", style: "font-size: 1.3rem; padding: 15px 30px;" %>
      </div>

      <% if @board.questions.any? %>
        <div class="row">
          <% @board.questions.order(created_at: :desc).each do |question| %>
            <div class="col-md-6 mb-4">
              <div class="card h-100 border-primary">
                <div class="card-header bg-primary text-white">
                  <h5 class="card-title mb-0">
                    <%= link_to question.title, [question.board, question], class: "text-white font-weight-bold", style: "font-size: 1.1rem; text-decoration: none;" %>
                  </h5>
                </div>
                <div class="card-body">
                  <p class="card-text"><%= truncate(question.content, length: 100) %></p>
                  <div class="d-flex justify-content-between align-items-center">
                    <small class="text-muted">
                      投稿者: <%= question.user.full_name %>
                    </small>
                    <small class="text-muted">
                      <%= question.created_at.strftime('%Y/%m/%d %H:%M') %>
                    </small>
                  </div>
                  <div class="mt-2">
                    <span class="badge badge-info">
                      回答数: <%= question.answers.count %>
                    </span>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center mt-5">
          <div class="alert alert-info">
            <h4>まだ質問がありません</h4>
            <p>この税制に関する最初の質問を投稿してみませんか？</p>
          </div>
        </div>
      <% end %>

      <div class="text-center mt-4">
        <%= link_to "掲示板一覧に戻る", boards_path, class: "btn btn-secondary" %>
      </div>
    </div>
  </div>
</div>
