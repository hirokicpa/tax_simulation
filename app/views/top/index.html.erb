<div class="row business-succession-container">
  <div class="card mx-auto col-12 col-md-10 col-lg-9 modern-card">
    <div class="card-body px-4 py-4">
      <div class="header-section text-center mb-4">
        <div class="icon-wrapper mb-3">
          <i class="fa fa-calculator fa-3x text-primary" aria-hidden="true"></i>
        </div>
        <h4 class="card-title mb-2 font-weight-bold">
          税金に関する計算を<br>手軽に自分でできる
        </h4>
        <p class="text-muted small mb-0">簡単な入力で税金に関する計算や様々なシミュレーションができるツールを提供しています</p>
      </div>

      <div class="alert alert-info alert-modern mb-4">
        <div class="d-flex align-items-start">
          <i class="fa fa-info-circle fa-lg mr-2 mt-1"></i>
          <div>
            <strong class="d-block mb-2">ご利用について</strong>
            <ul class="mb-0 pl-3">
              <li>各シミュレーションツールは、簡単な入力で税金計算が可能です。</li>
              <li>掲示板では、税制に関する質問や意見交換ができます。</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- 税金計算シミュレーション -->
      <div class="simulation-section mb-5">
        <h5 class="text-center mb-4" style="font-weight: 700; color: #2c3e50; font-size: 1.5rem;">
          <i class="fa fa-chart-line mr-2"></i>税金計算シミュレーション
        </h5>
        <div class="row justify-content-center">
          <div class="col-md-6 mb-3">
            <div class="d-flex flex-column align-items-center">
              <%= link_to simulations_incorporation_path, class: "btn btn-modern btn-primary mb-3 w-100", style: "max-width: 400px;" do %>
                <i class="fa fa-building mr-2"></i>法人化した場合の効果検証
              <% end %>
              
              <%= link_to simulations_succession_gift_path, class: "btn btn-modern btn-success mb-3 w-100", style: "max-width: 400px;" do %>
                <i class="fa fa-gift mr-2"></i>贈与した場合の相続税と贈与税の影響
              <% end %>
            </div>
          </div>
          <div class="col-md-6 mb-3">
            <div class="d-flex flex-column align-items-center">
              <%= link_to simulations_first_second_succession_path, class: "btn btn-modern btn-info mb-3 w-100", style: "max-width: 400px;" do %>
                <i class="fa fa-file-invoice-dollar mr-2"></i>一次二次の相続税の影響
              <% end %>
              
              <%= link_to simulations_business_succession_path, class: "btn btn-modern btn-warning mb-3 w-100", style: "max-width: 400px;" do %>
                <i class="fa fa-briefcase mr-2"></i>事業承継税制
              <% end %>
            </div>
          </div>
          <div class="col-md-6 mb-3">
            <div class="d-flex flex-column align-items-center">
              <%= link_to simulations_income_tax_path, class: "btn btn-modern btn-info mb-3 w-100", style: "max-width: 400px;" do %>
                <i class="fa fa-file-invoice-dollar mr-2"></i>所得税
              <% end %>
            </div>
          </div>
          <div class="col-md-6 mb-3">
            <div class="d-flex flex-column align-items-center">
              <%= link_to simulations_stock_valuation_path, class: "btn btn-modern btn-secondary mb-3 w-100", style: "max-width: 400px;" do %>
                <i class="fa fa-line-chart mr-2"></i>取引相場のない株式の評価
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <!-- AI事業承継診断 -->
      <div class="ai-diagnosis-section mb-5">
        <h5 class="text-center mb-3" style="font-weight: 700; color: #2c3e50; font-size: 1.5rem;">
          <i class="fa fa-stethoscope mr-2"></i>AI事業承継診断
        </h5>
        <p class="text-center text-muted mb-4 px-3">
          入力 → 税額・株価をルール計算 → AIがリスクと次アクションを説明。<br>
          あなたの会社、相続が起きたらいくら税金がかかるか把握していますか？
        </p>
        <div class="d-flex justify-content-center">
          <%= link_to simulations_business_succession_diagnosis_path, class: "btn btn-modern btn-diagnosis btn-lg", style: "max-width: 480px; width: 100%; display: inline-flex; align-items: center; justify-content: center;" do %>
            <i class="fa fa-stethoscope mr-2"></i>AI事業承継診断（約3分）
          <% end %>
        </div>
        <p class="text-center text-muted small mt-3 mb-0">
          自社株評価・相続税・納税資金不足リスクを簡易診断します
        </p>
      </div>

      <!-- 掲示板 -->
      <div class="board-section">
        <h5 class="text-center mb-4" style="font-weight: 700; color: #2c3e50; font-size: 1.5rem;">
          <i class="fa fa-comments mr-2"></i>相続事業承継に携わる全ての人の悩みをきっと解決
        </h5>
        <div class="d-flex justify-content-center">
          <%= link_to board_index_path, class: "btn btn-modern btn-primary btn-lg", style: "max-width: 400px; width: 100%; display: inline-flex; align-items: center; justify-content: center;" do %>
            <i class="fa fa-comments mr-2"></i>掲示板
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .simulation-section,
  .ai-diagnosis-section,
  .board-section {
    padding: 2rem 0;
  }
  
  .btn-modern {
    padding: 1.25rem 2rem;
    font-size: 1.1rem;
    font-weight: 600;
    border-radius: 12px;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 60px;
  }
  
  .btn-modern:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
  }
  
  .btn-modern.btn-primary {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
  }
  
  .btn-modern.btn-primary:hover {
    background: linear-gradient(135deg, #764ba2 0%, #667eea 100%);
    color: white;
  }
  
  .btn-modern.btn-success {
    background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
    color: white;
  }
  
  .btn-modern.btn-success:hover {
    background: linear-gradient(135deg, #38ef7d 0%, #11998e 100%);
    color: white;
  }
  
  .btn-modern.btn-warning {
    background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    color: white;
  }
  
  .btn-modern.btn-warning:hover {
    background: linear-gradient(135deg, #f5576c 0%, #f093fb 100%);
    color: white;
  }
  
  .btn-modern.btn-info {
    background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
    color: white;
  }
  
  .btn-modern.btn-info:hover {
    background: linear-gradient(135deg, #00f2fe 0%, #4facfe 100%);
    color: white;
  }

  .btn-modern.btn-secondary {
    background: linear-gradient(135deg, #6c757d 0%, #495057 100%);
    color: white;
  }

  .btn-modern.btn-secondary:hover {
    background: linear-gradient(135deg, #495057 0%, #6c757d 100%);
    color: white;
  }

  .btn-modern.btn-diagnosis {
    background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    color: white;
  }

  .btn-modern.btn-diagnosis:hover {
    background: linear-gradient(135deg, #f5576c 0%, #f093fb 100%);
    color: white;
  }
  
  @media (max-width: 768px) {
    .btn-modern {
      font-size: 1rem;
      padding: 1rem 1.5rem;
      min-height: 55px;
    }
  }
</style>
